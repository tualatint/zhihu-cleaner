{
  "manifest_version": 3,
  "name": "知乎净化器",
  "version": "1.4.0",
  "description": "移除知乎的广告、热榜/热搜、推荐信息流、视频流，以及关键词命中的低质内容。",
  "browser_specific_settings": {
    "gecko": {
      "id": "zhihu-cleaner@example.com",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["*://*.zhihu.com/*"],
  "action": {
    "default_title": "知乎净化器",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.zhihu.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
